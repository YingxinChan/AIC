# development | production — production refuses to start with the default SECRET_KEY below.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smarttrip
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
# Comma-separated frontend origin(s) allowed to call this API. Local dev only needs the
# Vite defaults below — production must be set to the real deployed frontend origin(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your-app-password
ANTHROPIC_API_KEY=your-anthropic-key
# Optional. Leave blank to use Open-Meteo's free tier (shared-IP rate limit).
# Set this once the team's paid plan is active to switch to the dedicated
# customer-* endpoints instead.
OPENMETEO_API_KEY=
